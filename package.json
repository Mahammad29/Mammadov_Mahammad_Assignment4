{
  "name": "myportfolio-assignment4",
  "version": "1.0.0",
  "description": "COMP229 Assignment 4 - Portfolio Testing, Performance Optimization, Deployment and CI/CD",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run client\" \"npm run server\"",
    "build": "npm --prefix client install && npm --prefix client run build"
  },
  "dependencies": {
    "body-parser": "^2.2.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-jwt": "^8.5.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mongoose": "^8.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14"
  }
}
